extends Area2D

# อย่าลืมไปที่แท็บ Node แล้วเชื่อม Signal 'body_entered' มาที่ฟังก์ชันนี้นะครับ
func _on_body_entered(body: Node2D) -> void:
	# เช็กว่าสิ่งที่มาชนคือผู้เล่นใช่หรือไม่
	if body.name == "Player":
		print("ผู้เล่นเหยียบส้มตำ! แสบท้องมาก!")
		
		# ถ้าอิงจากระบบเลือดที่คุณใช้ตอนเก็บหัวใจ สามารถลดเลือดผ่าน GameManager ได้เลย
		if GameManager.life > 0:
			GameManager.life -= 1
			
		# หมายเหตุ: ถ้าไม่ต้องการให้ส้มตำหายไปหลังเหยียบ (เป็นดงส้มตำหนาม) 
		# ก็ไม่ต้องใส่คำสั่ง queue_free() แบบตอนทำไอเทมหัวใจครับ
